# Set these in Render Environment; do not put a real key in GitHub.
# Without these two settings, the server uses a local JSON snapshot.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# PORT=3000
# STATE_FILE=./world_state.json
# RENDER_EXTERNAL_URL=https://cytophage.onrender.com
# 1 = realistic wall-clock pacing (one offspring per queen per hour)
# 10 = accelerated 10x simulation time for testing or fast observation
SIM_SPEED=1
